T* () Tj
T* (- Public IP: 134.209.182.39) Tj
T* (- Private IP observed on server: 10.16.0.5) Tj
T* (- App directory: /root/triciabales) Tj
T* (- PM2 app name: tricia-bales-api) Tj
T* (- Spring Boot artifact: target/baleshop-0.0.1-SNAPSHOT.jar) Tj
T* (- YenkasaChat proxy file: ) Tj
T* (/Users/kofibright/yenkasaChat/yenkasaChatBackend/RegLoginBackend/store/yenkasa-store-) Tj
T* (server.js) Tj
T* (- Proxy upstream env var: TRICIABALES_API_BASE) Tj
T* (- Proxy fallback: http://134.209.182.39:8080) Tj
T* () Tj
T* (SPRING DATASOURCE) Tj
T* () Tj
T* (Confirmed datasource in /root/triciabales/src/main/resources/application.properties:) Tj
T* () Tj
T* (- JDBC URL: jdbc:mysql://localhost:3306/bale_shop) Tj
T* (- Driver: com.mysql.cj.jdbc.Driver) Tj
T* (- Database user: balesuser) Tj
